# Template only - this file IS committed to GitHub, so never put real keys here.
# Copy it to .env (which git ignores) and put your real keys there:
#   cp .env.example .env

# Google AI Studio -> API Keys. Used by the app (parsing, explanations, embeddings).
GEMINI_API_KEY=

# Gemini models (checked with models.list() on 2026-11-15).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# Used automatically when the main model is overloaded (503/504).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# last.fm/api/account/create. Only used by scripts/build_catalog.py, not by the app.
LASTFM_API_KEY=
