%% Vibe DJ - system architecture (DRAFT: design target, updated as each part is built)
%% Solid arrows = data flow. Dotted arrows = where humans or tests check the AI.
flowchart TD
    subgraph BUILD["Offline build (run once)"]
        LFM[("Last.fm API<br/>top tracks + tags per genre")] --> BC["build_catalog.py<br/>Gemini estimates energy, valence, mood"]
        BC --> CSV[("data/songs.csv<br/>369 real songs, 32 genres")]
        LFM --> KB["build_knowledge.py<br/>genre wikis + artist bios"]
        KB --> KDOCS
        KDOCS[("knowledge/<br/>genres, artists, activities,<br/>Naija slang glossary")] --> IDX["Embedding index<br/>693 chunks, gemini-embedding-2"]
        CSV --> IDX
    end

    USER(["User request<br/>e.g. 'abeg I need gbedu for owambe'"]) --> CHECK{"0. Input check<br/>empty or over 500 chars?"}
    CHECK -- yes --> ASK["Ask them to rephrase<br/>(no API call spent)"]

    subgraph AGENT["Vibe DJ pipeline (src/vibe_dj.py, Gemini 3.8 Flash)"]
        RET["1. Retriever<br/>top hits from each of 5 sources:<br/>slang, activity, genre, artist, song<br/>(drops hits under 0.62)"] --> PARSE["2. Parse request<br/>few-shot prompt + retrieved knowledge<br/>-> profile JSON"]
        PARSE --> GIN{"3. Input guardrail<br/>music request? numbers in range?<br/>genre/mood/tags allowed?"}
        GIN -- off-topic --> REFUSE["Polite refusal"]
        GIN -- "ok (unknown genre -> closest + notice)" --> SCORE["4. Rank<br/>original VibeMatch scorer<br/>+ AI bonuses: matches your words,<br/>named / similar artist, no-vocals rule<br/>+ diversity penalty"]
        SCORE --> EXPLAIN["5. Explain<br/>Gemini writes about the 5 ranked songs only"]
        EXPLAIN --> GOUT{"6. Output guardrail<br/>only our song ids, each once,<br/>no other artists named?"}
        GOUT -- "no: retry once with the problems" --> EXPLAIN
        GOUT -- "still no" --> FALLBACK["Fallback write-up<br/>from scorer reasons"]
    end

    CHECK -- no --> RET
    IDX --> RET
    CSV --> SCORE
    GOUT -- yes --> OUT(["Playlist + why + notices<br/>(CLI now, Streamlit UI in task 5)"])
    FALLBACK --> OUT

    AGENT -. every step timed + logged .-> LOGS[("logs/vibe_dj.log<br/>+ trace in each result")]

    HUMAN1["Human review:<br/>Afro song rows + slang glossary"] -.-> CSV
    HUMAN1 -.-> KDOCS
    EVAL["eval.py<br/>~20 test requests -> PASS/FAIL"] -.-> AGENT
    TESTS["pytest: 19 offline tests<br/>scorer, guardrails, retry/fallback"] -.-> SCORE
    TESTS -.-> GIN
    TESTS -.-> GOUT
